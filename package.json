{
  "name": "porta-dysheme",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "validate:data": "tsx scripts/validate-data.ts",
    "build": "next build && tsx scripts/finalize-export.ts",
    "verify:export": "tsx scripts/verify-export.ts",
    "preview": "node scripts/serve-export.mjs --host 127.0.0.1 --port 4173",
    "lan-https:cert": "sh scripts/lan-https-cert.sh",
    "preview:lan": "node scripts/serve-export.mjs --host 0.0.0.0 --port 4443 --tls-key .lan-https/server.key --tls-cert .lan-https/server.crt --ca-cert .lan-https/porta-dev-ca.crt --ca-port 4080 --name \"$(scutil --get LocalHostName).local\"",
    "assets:images": "tsx scripts/prepare-images.ts",
    "verify:assets": "tsx scripts/verify-assets.ts",
    "assets:scenes": "tsx scripts/prepare-scenes.ts",
    "render:fixtures": "tsx scripts/render-fixtures.ts",
    "verify:budgets": "tsx scripts/verify-budgets.ts"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "next": "16.4.0",
    "photoswipe": "5.4.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "cheerio": "1.2.0",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "postcss": "8.5.23",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "type": "module"
}
